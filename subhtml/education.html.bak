<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Education</title>

    <!-- One CSS File -->
    <link rel="stylesheet" href="education.css">
</head>

<body>

    <!-- Header -->
    <header class="education-header">
        
        
        <h1>My Educational Journey</h1>
    </header>


    <!-- Education Section -->
    <section class="education">

        <div class="education-grid">

            <!-- School 1 -->
            <a href="primari.html" class="education-card">

                <img src="../images/blender/education/card/1.png" alt="Fordabad South Government Primary School">

                <div class="card-content">
                    <h3>Fordabad South Government Primary School</h3>

                    <p>🏫 Primary School</p>
                    <p>📅 2008 - 2013</p>
                    <p>📍 Bangladesh</p>

                    <span>View Details →</span>
                </div>

            </a>


            <!-- School 2 -->
            <a href="school.html" class="education-card">

                <img src="../images/blender/education/card/3.JPG" alt="My Secondary School">

                <div class="card-content">
                    <h3>Fordabad Ideal High School</h3>
                    <p>📚 Studied Accounting</p>

                    <p>🏫 Secondary School</p>
                    <p>📅 2014 - 2019</p>
                    <p>📍 Bangladesh</p>
                    <span>View Details →</span>
                </div>

            </a>


            <!-- College -->
            <a href="colleg.html" class="education-card">

            <img src="../images/blender/education/card/2.JPG" alt="My College">

                <div class="card-content">
                    <h3>Fordabad Dr. Rowshan Alam College</h3>
                    <p>📚 Studied Accounting</p>


                    <p>🎓 College</p>
                    <p>📅 2019 - 2021</p>
                    <p>📍 Bangladesh</p>

                    <span>View Details →</span>
                </div>

            </a>


            <!-- Japanese Language School -->
            <a href="japaniss.html" class="education-card">

                <img src="../images/blender/education/card/4.JPG" alt="Japanese Language School">

                <div class="card-content">
                    <h3>International Futurity Academy</h3>
                    <p>📚 Studied Japanese Language</p>


                    <p>🇯🇵 Japanese Language School</p>
                    <p>📅 2022- 2024</p>
                    <p>📍 Japan, osaka</p>
                    <span>View Details →</span>
                </div>

            </a>


            <!-- University -->
            <a href="univercity.html" class="education-card">

                <img src="../images/blender/education/card/5.JPG" alt="My University">

                <div class="card-content">
                    <h3>Hagoromo International University</h3>
                    <p>📚  Information Systems and Technology</p>



                    <p>🏛️ University</p>
                    <p>📅 2024 - Present</p>
                    <p>📍 Japan, osaka</p>
                    <span>View Details →</span>
                </div>

            </a>

        </div>

    </section>


    <!-- Footer -->
    <footer>
        <p>© 2026 My Education | All Rights Reserved</p>
    </footer>

</body>
</html>
