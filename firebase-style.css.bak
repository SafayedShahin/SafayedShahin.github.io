
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f7f7f5;
    color: #171717;
    line-height: 1.6;
    overflow-x: hidden;
}


/* =========================================================
   HEADER / NAVBAR
========================================================= */

header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);

    border-bottom: 1px solid #e5e5e5;
}

.navbar {
    width: 100%;
    max-width: 1200px;
    height: 75px;

    margin: 0 auto;
    padding: 0 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    flex-shrink: 0;

    font-size: 28px;
    font-weight: 800;
}

.nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 22px;

    list-style: none;
}

.nav-links a {
    display: block;

    color: #222;
    text-decoration: none;

    font-size: 14px;
    font-weight: 600;

    white-space: nowrap;

    transition: 0.3s ease;
}

.nav-links a:hover {
    color: #777;
}


/* =========================================================
   ANCHOR FIX
 ==================================== */

#home,
#about,
#skills,
#adventure,
#projects,
#comments,
#contact {
    scroll-margin-top: 90px;
}


/* =========================================================
   HERO
========================================================= */

.hero {
    width: 100%;
    max-width: 1200px;

    min-height: 100vh;

    margin: 0 auto;

    padding: 120px 30px 70px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 50px;
}

.hero-text {
    width: 100%;
    max-width: 650px;
}

.small-title {
    font-size: 13px;
    letter-spacing: 4px;
    font-weight: bold;

    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(50px, 7vw, 90px);
    line-height: 1;

    margin-bottom: 20px;
}

.hero h1 span {
    display: block;
    color: #666;
}

.hero h2 {
    font-size: 22px;
    margin-bottom: 20px;
}

.hero-text > p:not(.small-title) {
    max-width: 560px;

    color: #666;

    font-size: 17px;
}

.buttons {
    display: flex;
    flex-wrap: wrap;

    gap: 15px;

    margin-top: 30px;
}

.btn {
    display: inline-block;

    padding: 13px 25px;

    background: #171717;
    color: white;

    text-decoration: none;

    border-radius: 30px;

    transition: 0.3s ease;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn.secondary {
    background: transparent;
    color: #171717;

    border: 1px solid #171717;
}


/* =========================================================
   HERO IMAGE
========================================================= */

.hero-image {
    width: 380px;
    height: 380px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
}

.image-circle {
    width: 330px;
    height: 330px;

    overflow: hidden;

    border-radius: 50%;

    background: #deded9;

    border: 12px solid white;

    box-shadow: 0 15px 50px rgba(0, 0, 0, 0.12);

    display: flex;
    align-items: center;
    justify-content: center;
}

.image-circle img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;
}


/* =========================================================
   GENERAL SECTION
========================================================= */

.section {
    width: 100%;
    max-width: 1200px;

    margin: 0 auto;

    padding: 110px 30px;
}

.section-title {
    margin-bottom: 60px;
}

.section-title p {
    font-size: 12px;
    letter-spacing: 4px;
    font-weight: bold;

    color: #777;
}

.section-title h2 {
    font-size: 48px;
    line-height: 1.1;

    margin-top: 10px;
}


/* =========================================================
   ABOUT
========================================================= */

.about-content {
    display: grid;

    grid-template-columns: 1.4fr 1fr;

    gap: 80px;
}

.about-text h3 {
    font-size: 30px;

    margin-bottom: 20px;
}

.about-text p {
    color: #666;

    margin-bottom: 18px;
}

.about-card {
    border: 1px solid #ddd;
    border-radius: 20px;

    padding: 30px;
}

.about-card div {
    display: flex;
    justify-content: space-between;

    gap: 20px;

    padding: 18px 0;

    border-bottom: 1px solid #ddd;
}

.about-card div:last-child {
    border-bottom: none;
}

.about-card strong {
    font-size: 16px;
}

.about-card span {
    color: #777;

    text-align: right;
}


/* =========================================================
   DARK SECTION
========================================================= */

.dark-section {
    max-width: none;

    background: #04150a;
    color: white;
}

.dark-section > * {
    width: 100%;
    max-width: 1140px;

    margin-left: auto;
    margin-right: auto;
}

.dark-section .section-title p {
    color: #999;
}


/* =========================================================
   SKILLS
========================================================= */

.skills-container {
    width: 100%;

    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 20px;
}

.skill-card {
    width: 100%;
    min-width: 0;

    padding: 30px;

    border: 1px solid #8e1111;
    border-radius: 20px;

    min-height: 200px;

    transition: 0.3s ease;
}

.skill-card:hover {
    transform: translateY(-8px);

    background: #222;
}

.skill-card h3 {
    font-size: 27px;

    margin: 30px 0 15px;

    overflow-wrap: anywhere;
}

.skill-card p {
    color: #999;

    overflow-wrap: anywhere;
}


/* =========================================================
   ADVENTURE
========================================================= */

.adventure-grid {
    width: 100%;

    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 25px;
}

.adventure-card {
    width: 100%;
    min-width: 0;

    overflow: hidden;

    border-radius: 20px;

    background: white;

    border: 1px solid #ddd;
}

.adventure-image {
    width: 100%;
    height: 240px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, 0.926);

    position: relative;
}

.adventure-image span {
    font-size: 100px;
}

.adventure-image .btn {
    position: absolute;

    bottom: 10px;
    left: 50%;

    transform: translateX(-50%);

    padding: 9px 18px;

    font-size: 13px;

    white-space: nowrap;
}

.adventure-info {
    padding: 25px;
}

.adventure-info h3 {
    font-size: 24px;

    margin-bottom: 10px;
}

.adventure-info p {
    color: #090707;
}


/* =========================================================
   COMMENTS / FORM
========================================================= */

form {
    width: 100%;
    max-width: 500px;

    margin: 20px auto;
}

input,
textarea {
    width: 100%;

    padding: 12px;

    margin-bottom: 10px;

    border: 1px solid #ddd;
    border-radius: 8px;

    font-size: 15px;
}

textarea {
    height: 120px;

    resize: vertical;
}

button {
    padding: 12px 25px;

    background: #4f46e5;
    color: white;

    border: none;
    border-radius: 8px;

    cursor: pointer;

    transition: 0.3s;
}

button:hover {
    background: #3730a3;
}


/* =========================================================
   PROJECTS
========================================================= */

.projects-container {
    width: 100%;

    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    gap: 20px;
}

.project-card {
    width: 100%;
    min-width: 0;

    padding: 30px;

    border: 1px solid #8e1111;
    border-radius: 20px;

    min-height: 200px;
}

.project-number {
    color: #888;

    font-size: 14px;
}

.project-card h3 {
    font-size: 27px;

    margin: 30px 0 15px;

    overflow-wrap: anywhere;
}

.project-card p {
    color: #999;

    overflow-wrap: anywhere;
}

.project-card a {
    display: inline-block;

    margin-top: 25px;

    color: white;

    text-decoration: none;
}


/* =========================================================
   PROJECT PHOTO
========================================================= */

.project-photo {
    width: 300px;
    max-width: 100%;

    height: 200px;

    object-fit: cover;

    border-radius: 12px;

    margin: 10px 0;

    cursor: pointer;
}

.photo-popup {
    display: none;

    position: fixed;

    inset: 0;

    width: 100%;
    height: 100%;

    background: rgba(0, 0, 0, 0.8);

    justify-content: center;
    align-items: center;

    z-index: 9999;
}

.photo-popup img {
    max-width: 90vw;
    max-height: 90vh;

    object-fit: contain;
}

.close-popup {
    position: absolute;

    top: 20px;
    right: 30px;

    color: white;

    font-size: 40px;

    cursor: pointer;
}


/* =========================================================
   CONTACT
========================================================= */

.contact {
    text-align: center;
}

.contact .section-title {
    margin-bottom: 30px;
}

.contact-text {
    color: #f1f1f1;

    margin-bottom: 30px;
}

.contact-links {
    display: flex;

    justify-content: center;

    gap: 15px;

    flex-wrap: wrap;
}

.contact-links a {
    text-decoration: none;

    color: #fffffff5;

    border: 1px solid #ccc;

    padding: 12px 22px;

    border-radius: 30px;

    transition: 0.3s;
}

.contact-links a:hover {
    background: #171717;
    color: white;
}


/* =========================================================
   FOOTER
========================================================= */

footer {
    background: #111111;

    color: white;

    text-align: center;

    padding: 50px 20px;
}

footer h3 {
    font-size: 28px;
}

footer p {
    color: #ffffff;

    margin-top: 8px;
}

.copyright {
    font-size: 13px;

    margin-top: 25px;
}


/* =========================================================
   TABLET
========================================================= */

@media screen and (max-width: 1000px) {

    .navbar {
        padding: 0 20px;
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: 12px;
    }

    .hero {
        padding-left: 25px;
        padding-right: 25px;

        gap: 30px;
    }

    .hero-image {
        width: 320px;
        height: 320px;
    }

    .image-circle {
        width: 290px;
        height: 290px;
    }

    .about-content {
        gap: 40px;
    }

    .skills-container,
    .projects-container,
    .adventure-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


/* =========================================================
   MOBILE
========================================================= */

@media screen and (max-width: 800px) {

    /* HEADER */

    .navbar {
        height: auto;

        padding: 8px 10px;

        flex-direction: column;

        gap: 5px;
    }

    .logo {
        font-size: 22px;

        line-height: 1.2;
    }

    .nav-links {
        width: 100%;

        display: flex;

        flex-wrap: wrap;

        justify-content: center;

        gap: 3px;
    }

    .nav-links a {
        font-size: 11px;

        padding: 4px 6px;
    }


    /* HERO */

    .hero {
        min-height: auto;

        padding: 120px 20px 50px;

        flex-direction: column;

        text-align: center;

        gap: 35px;
    }

    .hero-text {
        max-width: 100%;
    }

    .hero h1 {
        font-size: clamp(40px, 10vw, 65px);
    }

    .hero h2 {
        font-size: 19px;
    }

    .hero-text > p:not(.small-title) {
        font-size: 15px;
    }

    .buttons {
        justify-content: center;
    }


    /* IMAGE */

    .hero-image {
        width: 100%;
        height: auto;
    }

    .image-circle {
        width: min(75vw, 300px);
        height: min(75vw, 300px);

        border-width: 8px;
    }


    /* SECTION */

    .section {
        padding: 65px 20px;
    }

    .section-title {
        margin-bottom: 35px;
    }

    .section-title h2 {
        font-size: 40px;
    }


    /* ABOUT */

    .about-content {
        grid-template-columns: 1fr;

        gap: 30px;
    }


    /* CARDS */

    .skills-container,
    .projects-container,
    .adventure-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 12px;
    }

    .skill-card,
    .project-card,
    .adventure-card {
        padding: 18px;

        border-radius: 15px;
    }

    .skill-card {
        min-height: 170px;
    }

    .skill-card h3,
    .project-card h3 {
        font-size: 20px;

        margin: 15px 0 10px;
    }

    .skill-card p,
    .project-card p {
        font-size: 13px;
    }

    .adventure-image {
        height: 170px;
    }

    .adventure-image span {
        font-size: 75px;
    }

    .adventure-info {
        padding: 15px;
    }

    .adventure-info h3 {
        font-size: 19px;
    }

    .adventure-info p {
        font-size: 13px;
    }

    .project-card a {
        margin-top: 15px;

        font-size: 13px;
    }
}


/* =========================================================
   SMALL PHONE
========================================================= */

@media screen and (max-width: 480px) {

    .navbar {
        padding: 6px 5px;

        gap: 3px;
    }

    .logo {
        font-size: 20px;
    }

    .nav-links {
        gap: 2px;
    }

    .nav-links a {
        font-size: 10px;

        padding: 4px 5px;
    }

    #home,
    #about,
    #skills,
    #adventure,
    #projects,
    #comments,
    #contact {
        scroll-margin-top: 100px;
    }


    /* HERO */

    .hero {
        padding: 105px 15px 35px;

        gap: 25px;
    }

    .hero h1 {
        font-size: 34px;

        line-height: 1.15;
    }

    .hero h2 {
        font-size: 16px;
    }

    .hero-text > p:not(.small-title) {
        font-size: 14px;
    }

    .small-title {
        font-size: 10px;

        letter-spacing: 2px;
    }

    .btn {
        padding: 10px 18px;

        font-size: 13px;
    }


    /* IMAGE */

    .image-circle {
        width: 75vw;
        height: 75vw;

        max-width: 280px;
        max-height: 280px;
    }


    /* SECTION */

    .section {
        padding: 45px 15px;
    }

    .section-title {
        margin-bottom: 25px;
    }

    .section-title p {
        font-size: 10px;

        letter-spacing: 2px;
    }

    .section-title h2 {
        font-size: 32px;
    }


    /* CARDS */

    .skills-container,
    .projects-container,
    .adventure-grid {
        width: 100%;

        grid-template-columns: repeat(2, minmax(0, 1fr));

        gap: 8px;
    }

    .skill-card,
    .project-card,
    .adventure-card {
        padding: 12px;

        border-radius: 12px;
    }

    .skill-card {
        min-height: 150px;
    }

    .skill-card h3,
    .project-card h3 {
        font-size: 16px;

        line-height: 1.25;

        margin: 10px 0;
    }

    .skill-card p,
    .project-card p,
    .adventure-info p {
        font-size: 11px;

        line-height: 1.4;
    }

    .project-number {
        font-size: 10px;
    }

    .project-card a {
        font-size: 11px;

        margin-top: 10px;
    }

    .adventure-image {
        height: 125px;
    }

    .adventure-image span {
        font-size: 55px;
    }

    .adventure-image .btn {
        bottom: 8px;

        padding: 6px 10px;

        font-size: 10px;
    }

    .adventure-info {
        padding: 10px;
    }

    .adventure-info h3 {
        font-size: 15px;

        margin-bottom: 5px;
    }


    /* ABOUT CARD */

    .about-card {
        padding: 15px;

        border-radius: 14px;
    }

    .about-card div {
        padding: 12px 0;

        gap: 10px;

        font-size: 13px;
    }

    .about-card strong {
        font-size: 13px;
    }

    .about-card span {
        font-size: 12px;
    }


    /* FOOTER */

    footer {
        padding: 35px 15px;
    }

    footer h3 {
        font-size: 23px;
    }
}


/* =========================================================
   VERY SMALL PHONE
========================================================= */

@media screen and (max-width: 360px) {

    .nav-links a {
        font-size: 9px;

        padding: 3px 4px;
    }

    .hero h1 {
        font-size: 30px;
    }

    .section-title h2 {
        font-size: 28px;
    }

    .skills-container,
    .projects-container,
    .adventure-grid {
        gap: 6px;
    }

    .skill-card,
    .project-card,
    .adventure-card {
        padding: 10px;
    }

    .skill-card h3,
    .project-card h3 {
        font-size: 14px;
    }

    .skill-card p,
    .project-card p,
    .adventure-info p {
        font-size: 10px;
    }
}



/* =========================================
   HERO → ABOUT GAP FIX
========================================= */

.hero {
    min-height: auto;
    height: auto;
    padding-top: 120px;
    padding-bottom: 40px;
    margin-bottom: 0;
}

#about {
    margin-top: 0;
    padding-top: 55px;
}


/* =========================
   TABLET / MOBILE
========================= */

@media screen and (max-width: 800px) {

    .hero {
        min-height: auto;
        height: auto;
        padding-top: 110px;
        padding-bottom: 25px;
        gap: 20px;
    }

    #about {
        padding-top: 35px;
    }
}


/* =========================
   SMALL MOBILE
========================= */

@media screen and (max-width: 480px) {

    .hero {
        min-height: auto;
        padding-top: 100px;
        padding-bottom: 15px;
        gap: 15px;
    }

    #about {
        padding-top: 30px;
    }
}
/* =========================================
   CARD BACKGROUND → BLACK
========================================= */

/* Skills + Projects section */
.dark-section {
    background: #000000 !important;
}

/* Skill cards */
.skill-card {
    background: #000000;
    border-color: #8e1111;
}

/* Project cards */
.project-card {
    background: #000000;
    border-color: #8e1111;
}

/* Hover করলে */
.skill-card:hover,
.project-card:hover {
    background: #111111;
}


/* =========================================
   ADVENTURE CARD
========================================= */

.adventure-card {
    background: #000000;
    color: white;
}

.adventure-info {
    background: #000000;
    color: white;
}

.adventure-info h3 {
    color: white;
}

.adventure-info p {
    color: #cccccc;
}